# Environment Configuration for VyManager Production
# Domain: infra.vyprojects.org

# ============================================================================
# Application Environment
# ============================================================================
NODE_ENV=production
VYMANAGER_ENV=production

# ============================================================================
# Better Auth Configuration
# ============================================================================
# IMPORTANT: Generate a secure secret for production!
# You can generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-change-in-production
BETTER_AUTH_SECURE_COOKIES=true

# Base URL for Better Auth (where your app is accessible)
BETTER_AUTH_URL=https://infra.vyprojects.org
NEXT_PUBLIC_APP_URL=https://infra.vyprojects.org

# Backend API URL
# NEXT_PUBLIC_API_URL is for client-side browser requests (via Traefik)
NEXT_PUBLIC_API_URL=https://infra.vyprojects.org
# INTERNAL_API_URL is for server-side API routes within Docker network
INTERNAL_API_URL=http://vymanager-backend:8000

# Trusted origins for CORS
TRUSTED_ORIGINS=https://infra.vyprojects.org

# Database URL
DATABASE_URL=postgresql://vymanager:vymanager_secure_password@postgres:5432/vymanager_auth

# ============================================================================
# Notes
# ============================================================================
# - Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
# - Ensure BETTER_AUTH_SECURE_COOKIES=true for HTTPS
# - All traffic goes through Traefik on port 443
