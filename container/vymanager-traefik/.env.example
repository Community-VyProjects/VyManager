# =============================================================================
# VyManager — Traefik Deployment Configuration
# =============================================================================
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# Generate secrets:
#   BETTER_AUTH_SECRET:  openssl rand -base64 32
#   SSH_ENCRYPTION_KEY:  openssl rand -hex 32
#   DB_PASSWORD:         openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
# =============================================================================

# ── Domain & TLS ─────────────────────────────────────────────────────────────
DOMAIN=d.vyprojects.org
ACME_EMAIL=admin@vyprojects.org

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production

BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_SECURE_COOKIES=true
BETTER_AUTH_URL=https://d.vyprojects.org
NEXT_PUBLIC_APP_URL=https://d.vyprojects.org

BACKEND_URL=http://backend:8000
FRONTEND_URL=https://d.vyprojects.org
TRUSTED_ORIGINS=https://d.vyprojects.org

SSH_ENCRYPTION_KEY=CHANGE_ME

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=vymanager
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://vymanager:CHANGE_ME@postgres:5432/vymanager
