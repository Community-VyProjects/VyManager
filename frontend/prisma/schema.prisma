// Prisma Schema for VyManager Authentication & RBAC
// Better Auth compatible schema with role-based access control

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Better Auth Core Models
// ============================================================================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // RBAC
  role Role @default(VIEWER)


  isDemo Boolean @default(false)

  // Relations
  sessions          Session[]
  accounts          Account[]
  activeSession     ActiveSession?
  userInstanceRoles UserInstanceRole[]
  orgMembers        OrgMember[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now()) @updatedAt // Track last activity for inactivity timeout
  ipAddress      String?
  userAgent      String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastActivityAt]) // Index for cleanup queries
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// ============================================================================
// RBAC - Role Based Access Control
// ============================================================================

// Site-level roles (platform-wide permissions)
enum Role {
  PROJECT_ADMIN // Full access across ALL organizations
  ORG_ADMIN     // Full admin within own organization(s)
  ADMIN         // @deprecated - use PROJECT_ADMIN or ORG_ADMIN
  VIEWER        // Read-only access to assigned sites and instances
}

// Instance-level roles (per-instance permissions)
enum InstanceRole {
  ADMIN    // Full access to all features on this instance
  EDITOR   // DEPRECATED - Use OPERATOR instead (kept for database compatibility)
  OPERATOR // Can edit specific features (defined in FeaturePermission)
  VIEWER   // Can view specific features (defined in FeaturePermission)
}

// Role Permissions Matrix
// Define what each role can access

model RolePermission {
  id        String   @id @default(cuid())
  role      Role
  resource  String // e.g., "firewall", "dhcp", "nat", "interfaces", "users"
  action    Action // e.g., READ, CREATE, UPDATE, DELETE
  createdAt DateTime @default(now())

  @@unique([role, resource, action])
  @@map("role_permissions")
}

enum Action {
  READ
  CREATE
  UPDATE
  DELETE
  MANAGE // Full control (all actions)
}

// Audit Log for tracking all user actions
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  action    String // e.g., "CREATE_FIREWALL_RULE", "DELETE_NAT_RULE"
  resource  String // e.g., "firewall.rule.100"
  details   Json? // Additional context
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Multi-Instance Management
// ============================================================================

// Site - Represents a customer/organization
model Site {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  instances Instance[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("sites")
}

// Instance - Represents a VyOS router within a site
model Instance {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  description String?
  host        String
  port        Int      @default(443)
  username    String
  password    String // Will be encrypted by backend
  apiKey      String? // Optional API key for VyOS
  vyosVersion String? // VyOS version (e.g., "1.4", "1.5")
  protocol    String   @default("https") // http or https
  verifySsl   Boolean  @default(false) // Verify SSL certificate
  isActive    Boolean  @default(true)

  // Commit-confirm settings
  commitConfirmEnabled Boolean @default(false) // Use commit-confirm for all changes
  commitConfirmMinutes Int     @default(5)      // Minutes before auto-revert if not confirmed
  timeout              Int     @default(10)     // API request timeout in seconds

  // SSH / Monitoring fields
  sshPort           Int      @default(22)
  sshUsername        String?
  sshPublicKey       String?  @db.Text
  sshEncryptedPrivKey String? @db.Text
  sshKeyNonce        String?
  sshKeyConfigured   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  activeSessions    ActiveSession[]
  userInstanceRoles UserInstanceRole[]

  @@unique([siteId, name])
  @@index([siteId])
  @@map("instances")
}

// ActiveSession - Tracks which instance a user is currently connected to
model ActiveSession {
  id             String   @id @default(cuid())
  userId         String   @unique
  instanceId     String
  sessionToken   String? // Auth session token that created this VyOS connection
  connectedAt    DateTime @default(now())
  lastActivityAt DateTime @default(now()) @updatedAt // Track last activity for timeout

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([lastActivityAt]) // Index for cleanup queries
  @@map("active_sessions")
}

// ScheduledPowerAction - Tracks scheduled reboots/poweroffs
model ScheduledPowerAction {
  id              String    @id @default(cuid())
  instanceId      String // Which VyOS instance
  actionType      String // "reboot" or "poweroff"
  scheduledTime   DateTime // When the action will occur
  scheduledBy     String // User ID who scheduled it
  scheduledByName String // User name for display
  cancelled       Boolean   @default(false)
  cancelledBy     String? // User ID who cancelled
  cancelledByName String? // User name who cancelled
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([instanceId])
  @@index([scheduledTime])
  @@map("scheduled_power_actions")
}

// ============================================================================
// OAuth Provider Configuration
// ============================================================================

// OAuthProvider - Stores admin-configured OAuth/OIDC provider settings
model OAuthProvider {
  id           String   @id @default(cuid())
  providerId   String   @unique // e.g. "google", "github", "keycloak-corp"
  displayName  String           // e.g. "Google", "GitHub"
  enabled      Boolean  @default(false)

  // OAuth credentials
  clientId     String   @db.Text
  clientSecret String   @db.Text

  // OIDC discovery (preferred) — covers most modern providers
  discoveryUrl String?  @db.Text

  // Manual endpoints (fallback for non-OIDC providers)
  authorizationUrl String? @db.Text
  tokenUrl         String? @db.Text
  userInfoUrl      String? @db.Text

  // Optional configuration
  scopes   String? // space-separated scopes
  pkce     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("oauth_providers")
}

// DashboardLayout - Stores user's custom dashboard layout per instance
model DashboardLayout {
  id         String   @id @default(cuid())
  userId     String // User who owns this layout
  instanceId String // VyOS instance this layout is for
  layout     Json // JSON object storing grid positions and card configurations
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, instanceId])
  @@index([userId])
  @@index([instanceId])
  @@map("dashboard_layouts")
}

// ============================================================================

// ============================================================================

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isDemo      Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  sites   Site[]
  members OrgMember[]

  @@index([isDemo, expiresAt])
  @@map("organizations")
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

enum OrgRole {
  OWNER
  MEMBER
}

// ============================================================================
// New RBAC System - Fine-Grained Per-Instance Permissions
// ============================================================================

// Feature Groups - Logical groupings of VyOS features
// Stage 1: Core features (expandable later)
enum FeatureGroup {
  FIREWALL // Firewall rules and groups
  INTERFACES // Network interfaces
  DHCP // DHCP server
  NAT // NAT rules
  MONITORING // SSH monitoring / live traffic
}

// Note: CustomRole and FeaturePermission models removed in favor of simplified
// UserFeaturePermission model that directly ties to UserInstanceRole

// UserInstanceRole - Assigns users to instances with specific roles
// Simplified: ADMIN (all access), EDITOR (feature-specific write), VIEWER (feature-specific read)
model UserInstanceRole {
  id         String       @id @default(cuid())
  userId     String
  instanceId String
  role       InstanceRole // ADMIN, EDITOR, or VIEWER
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  assignedBy String // User ID who assigned this role

  // Relations
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance           Instance                @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  featurePermissions UserFeaturePermission[] // Only used for EDITOR/VIEWER roles

  @@unique([userId, instanceId])
  @@index([userId])
  @@index([instanceId])
  @@map("user_instance_roles")
}

// UserFeaturePermission - Defines which features an EDITOR/VIEWER can access
// Only applies when UserInstanceRole.role is EDITOR or VIEWER
// If role is ADMIN, this table is ignored (full access)
model UserFeaturePermission {
  id                 String       @id @default(cuid())
  userInstanceRoleId String
  feature            FeatureGroup
  canEdit            Boolean      @default(false) // For EDITOR role
  canView            Boolean      @default(false) // For VIEWER role
  createdAt          DateTime     @default(now())

  // Relations
  userInstanceRole UserInstanceRole @relation(fields: [userInstanceRoleId], references: [id], onDelete: Cascade)

  @@unique([userInstanceRoleId, feature])
  @@index([userInstanceRoleId])
  @@map("user_feature_permissions")
}
