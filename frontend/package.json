    "next-intl": "^4.14.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7",
    "zustand": "^5.0.2"
