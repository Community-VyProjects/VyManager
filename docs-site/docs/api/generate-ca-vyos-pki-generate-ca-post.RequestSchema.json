{"title":"Body","body":{"content":{"application/json":{"schema":{"properties":{"name":{"type":"string","title":"Name","description":"CA name"},"key_type":{"type":"string","enum":["rsa","ec"],"title":"Key Type","description":"Key type: rsa or ec","default":"rsa"},"key_size":{"type":"integer","title":"Key Size","description":"Key size in bits (RSA: 2048/3072/4096, EC: 256/384/521)","default":2048},"country":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Country","description":"Country code (2 letters)"},"state":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"State","description":"State or province"},"locality":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Locality","description":"Locality or city"},"organization":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Organization","description":"Organization name"},"common_name":{"type":"string","title":"Common Name","description":"Common Name (CN)"},"days":{"type":"integer","title":"Days","description":"Validity period in days","default":3650},"encrypt_key":{"type":"boolean","title":"Encrypt Key","description":"Encrypt the private key with a passphrase","default":false},"passphrase":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Passphrase","description":"Passphrase for key encryption (required if encrypt_key is True)"},"revoke":{"type":"boolean","title":"Revoke","description":"Mark as revoked","default":false},"system_install":{"type":"boolean","title":"System Install","description":"Install to system trust store","default":false}},"type":"object","required":["name","common_name"],"title":"GenerateCARequest","description":"Request to generate a self-signed Certificate Authority."}}},"required":true}}