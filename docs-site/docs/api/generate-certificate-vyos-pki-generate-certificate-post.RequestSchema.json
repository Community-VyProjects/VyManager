{"title":"Body","body":{"content":{"application/json":{"schema":{"properties":{"name":{"type":"string","title":"Name","description":"Certificate name"},"ca_name":{"type":"string","title":"Ca Name","description":"Name of the CA to sign with"},"key_type":{"type":"string","enum":["rsa","ec"],"title":"Key Type","description":"Key type: rsa or ec","default":"rsa"},"key_size":{"type":"integer","title":"Key Size","description":"Key size (RSA: 2048/3072/4096, EC: 256/384/521)","default":2048},"country":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Country","description":"Country code (2 letters)"},"state":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"State","description":"State or province"},"locality":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Locality","description":"Locality or city"},"organization":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Organization","description":"Organization name"},"common_name":{"type":"string","title":"Common Name","description":"Common Name (CN)"},"days":{"type":"integer","title":"Days","description":"Validity period in days","default":365},"subject_alt_names":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"title":"Subject Alt Names","description":"Subject Alternative Names (DNS names or IPs)"},"encrypt_key":{"type":"boolean","title":"Encrypt Key","description":"Encrypt the private key with a passphrase","default":false},"passphrase":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Passphrase","description":"Passphrase for key encryption"}},"type":"object","required":["name","ca_name","common_name"],"title":"GenerateCertificateRequest","description":"Request to generate a certificate signed by an existing CA."}}},"required":true}}