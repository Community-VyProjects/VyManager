# ==============================================================================
# VyManager - Unified Environment Configuration
# ==============================================================================
# This is the ONLY .env file needed for the entire VyManager stack.
# Copy this file to .env and update with your details.
#
# Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Update DOMAIN and ACME_EMAIL below
#   3. Generate auth secret: BETTER_AUTH_SECRET=$(openssl rand -base64 32)
#   4. Start: docker-compose -f container/vymanager-dev/env-file-docker-compose.yml up -d
#
# See the DEPLOYMENT SCENARIOS section at the bottom for specific configurations.
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain Configuration (Docker with Traefik)
# ------------------------------------------------------------------------------
# Your domain where VyManager will be accessible
# Used by Traefik for routing and SSL certificate
DOMAIN=example.com

# Email for Let's Encrypt SSL certificate notifications
# You'll receive warnings if certificate renewal fails
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
VYMANAGER_ENV=production

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL credentials (used by docker-compose to create the database)
POSTGRES_USER=vymanager
POSTGRES_PASSWORD=vymanager_secure_password
POSTGRES_DB=vymanager_auth

# PostgreSQL connection string (used by frontend and backend applications)
# - Docker: use container name 'postgres' as host
# - Non-Docker: use 'localhost' or your database server IP/hostname
DATABASE_URL=postgresql://vymanager:vymanager_secure_password@postgres:5432/vymanager_auth

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# CORS - URL where the frontend is hosted (for cross-origin requests)
# Used by backend to allow requests from the frontend
FRONTEND_URL=https://example.com

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------

# Better Auth Secret
# CRITICAL: Generate a secure secret for production!
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-change-in-production

# Better Auth Secure Cookies
# - true: Cookies only sent over HTTPS (required for production)
# - false: Cookies work over HTTP (only for local development)
BETTER_AUTH_SECURE_COOKIES=true

# Better Auth URL - The canonical URL where your app is accessible
# Used internally by Better Auth for callbacks and redirects
BETTER_AUTH_URL=https://example.com

# Public App URL - The URL users see in their browser
NEXT_PUBLIC_APP_URL=https://example.com

# Backend API URLs - IMPORTANT: Understand the difference!
#
# NEXT_PUBLIC_API_URL (Client-side / Browser requests)
#   - Used by JavaScript running IN THE BROWSER
#   - Must be publicly accessible from user's machine
#   - Goes through your reverse proxy (Traefik/Nginx)
#
# INTERNAL_API_URL (Server-side / Next.js API routes)
#   - Used by Next.js SERVER for internal API calls
#   - Docker: Use container name (http://vymanager-backend:8000)
#   - Non-Docker: Use localhost (http://localhost:8000)
#   - Never exposed to the browser
#
NEXT_PUBLIC_API_URL=https://example.com
INTERNAL_API_URL=http://vymanager-backend:8000

# Trusted origins for CORS (comma-separated for multiple)
TRUSTED_ORIGINS=https://example.com


# ==============================================================================
# DEPLOYMENT SCENARIOS
# ==============================================================================
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SCENARIO 1: Public Domain with Let's Encrypt (Recommended for Production)   │
# │ Use: docker-compose.letsencrypt.yml                                         │
# ├─────────────────────────────────────────────────────────────────────────────┤
# │                                                                             │
# │  DOMAIN=yourdomain.com                                                      │
# │  ACME_EMAIL=admin@yourdomain.com                                            │
# │                                                                             │
# │  FRONTEND_URL=https://yourdomain.com                                        │
# │  NEXT_PUBLIC_API_URL=https://yourdomain.com                                 │
# │  INTERNAL_API_URL=http://vymanager-backend:8000                             │
# │  BETTER_AUTH_URL=https://yourdomain.com                                     │
# │  BETTER_AUTH_SECURE_COOKIES=true                                            │
# │                                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SCENARIO 2: Local Network with Self-Signed/Custom Certificate               │
# │ Use: docker-compose.local-https.yml                                         │
# ├─────────────────────────────────────────────────────────────────────────────┤
# │                                                                             │
# │  DOMAIN=192.168.1.100                        ← Your local IP                │
# │  ACME_EMAIL=                                 ← Not needed for local         │
# │                                                                             │
# │  FRONTEND_URL=https://192.168.1.100                                         │
# │  NEXT_PUBLIC_API_URL=https://192.168.1.100                                  │
# │  INTERNAL_API_URL=http://vymanager-backend:8000                             │
# │  BETTER_AUTH_URL=https://192.168.1.100                                      │
# │  BETTER_AUTH_SECURE_COOKIES=false            ← false for self-signed certs  │
# │                                                                             │
# │  Generate cert: openssl req -x509 -nodes -days 365 -newkey rsa:2048 \       │
# │    -keyout certs/server.key -out certs/server.crt \                         │
# │    -subj "/CN=192.168.1.100" -addext "subjectAltName=IP:192.168.1.100"      │
# │                                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SCENARIO 3: Docker without Traefik (External Reverse Proxy)                 │
# │ Services in Docker, but you use Nginx/Caddy/etc. outside Docker             │
# ├─────────────────────────────────────────────────────────────────────────────┤
# │                                                                             │
# │  Same as Scenario 1, but expose ports in docker-compose:                    │
# │    frontend: ports: ["3000:3000"]                                           │
# │    backend:  ports: ["8000:8000"]                                           │
# │                                                                             │
# │  Then configure your external reverse proxy to route to those ports.        │
# │                                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SCENARIO 4: Non-Docker / Self-Hosted (All services on same machine)         │
# │ Running frontend, backend, and PostgreSQL directly on the host              │
# ├─────────────────────────────────────────────────────────────────────────────┤
# │                                                                             │
# │  DATABASE_URL=postgresql://vymanager:PASSWORD@localhost:5432/vymanager_auth │
# │                                                ^^^^^^^^^                    │
# │                                                localhost or 127.0.0.1       │
# │                                                                             │
# │  FRONTEND_URL=http://localhost:3000          ← Or your domain if proxied    │
# │  NEXT_PUBLIC_API_URL=http://localhost:8000   ← Browser connects here        │
# │  INTERNAL_API_URL=http://localhost:8000      ← Same as public (no Docker)   │
# │                      ^^^^^^^^^                                              │
# │                      Both use localhost since no Docker network             │
# │                                                                             │
# │  BETTER_AUTH_URL=http://localhost:3000                                      │
# │  BETTER_AUTH_SECURE_COOKIES=false            ← false for HTTP development   │
# │                                                                             │
# │  For production without Docker, put a reverse proxy in front and use HTTPS: │
# │  FRONTEND_URL=https://yourdomain.com                                        │
# │  NEXT_PUBLIC_API_URL=https://yourdomain.com  ← Via reverse proxy            │
# │  INTERNAL_API_URL=http://localhost:8000      ← Direct to backend            │
# │  BETTER_AUTH_SECURE_COOKIES=true                                            │
# │                                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SCENARIO 5: Local Development (Quick start for developers)                  │
# ├─────────────────────────────────────────────────────────────────────────────┤
# │                                                                             │
# │  NODE_ENV=development                                                       │
# │  DATABASE_URL=postgresql://vymanager:vymanager@localhost:5432/vymanager_auth│
# │  FRONTEND_URL=http://localhost:3000                                         │
# │  NEXT_PUBLIC_API_URL=http://localhost:8000                                  │
# │  INTERNAL_API_URL=http://localhost:8000                                     │
# │  BETTER_AUTH_URL=http://localhost:3000                                      │
# │  NEXT_PUBLIC_APP_URL=http://localhost:3000                                  │
# │  BETTER_AUTH_SECRET=dev-secret-not-for-production                           │
# │  BETTER_AUTH_SECURE_COOKIES=false                                           │
# │  TRUSTED_ORIGINS=http://localhost:3000                                      │
# │                                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# ==============================================================================
# UNDERSTANDING THE API URL FLOW
# ==============================================================================
#
#   User's Browser                    Your Server
#   ─────────────                     ───────────────────────────────────────
#                                     
#   ┌─────────┐    HTTPS request      ┌─────────────────┐
#   │ Browser │ ──────────────────────▶ Reverse Proxy   │ (Traefik/Nginx)
#   │         │    to your domain     │ (Port 443)      │
#   └─────────┘                       └────────┬────────┘
#        │                                     │
#        │ Uses NEXT_PUBLIC_API_URL            │ Routes to containers
#        │ (https://yourdomain.com)            │
#        │                                     ▼
#        │                            ┌─────────────────┐
#        │                            │ Frontend        │ (Next.js :3000)
#        │                            │                 │
#        │                            │ API Routes use  │
#        │                            │ INTERNAL_API_URL│───────┐
#        │                            └─────────────────┘       │
#        │                                                      │
#        │                            ┌─────────────────┐       │
#        │                            │ Backend         │◀──────┘
#        │                            │ (FastAPI :8000) │
#        │                            └─────────────────┘
#        │                                     │
#        │                                     │ Uses DATABASE_URL
#        │                                     ▼
#        │                            ┌─────────────────┐
#        │                            │ PostgreSQL      │
#        │                            │ (:5432)         │
#        │                            └─────────────────┘
#
# ==============================================================================
